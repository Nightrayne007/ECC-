DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis000
REDIS_URL=redis://localhost:6379/0

# mock (default, no credentials needed) | claude
AEGIS_LLM_PROVIDER=mock
# mock (default, no audio needed) | hosted
AEGIS_TRANSCRIPTION_ADAPTER=mock
# mock (default, transcript-derived heuristics) | signal (real audio DSP, needs an audio source wired up)
AEGIS_DISTRESS_ANALYZER=mock
# mock (default; photo upload is real, livestream is a placeholder) | webrtc (needs an AU-region SFU)
AEGIS_LIVESTREAM_PROVIDER=mock
# local (default, dev-only filesystem) | object (AU-region object store, not wired in this scaffold)
AEGIS_MEDIA_STORE=local

# Explicit AU region — never rely on an incidental provider default.
AEGIS_DATA_REGION=ap-southeast-2
AEGIS_RETENTION_DAYS=365

# On-demand caller media (Phase 3). CHANGE the invite secret for any real deployment.
AEGIS_MEDIA_INVITE_SECRET=dev-insecure-invite-secret-change-me
AEGIS_MEDIA_INVITE_TTL_SECONDS=900
AEGIS_MEDIA_LOCAL_DIR=/tmp/aegis-media
AEGIS_MEDIA_INVITE_BASE_URL=http://localhost:5173
# Only required when AEGIS_LIVESTREAM_PROVIDER=webrtc
AEGIS_LIVESTREAM_SFU_ENDPOINT=

# Radio monitoring (Phase 4). mock (default, synthetic chatter) | openmhz (real free API, dev-only)
AEGIS_RADIO_FEED=mock
AEGIS_RADIO_SIGNAL_CATALOG=../rubrics/example-radio-signals.yaml
# Only required when AEGIS_RADIO_FEED=openmhz (an OpenMHz system short-name)
AEGIS_RADIO_OPENMHZ_SYSTEM=
AEGIS_RADIO_OPENMHZ_BASE_URL=https://api.openmhz.com

# Only required when AEGIS_LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# Only required when AEGIS_TRANSCRIPTION_ADAPTER=hosted
STT_ENDPOINT_URL=
